# Upload OCR provider: ollama (local default) or sarvam (API)
OCR_MODEL=ollama

# Local Ollama vision OCR. Keep OLLAMA_MODEL separate for answer generation.
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_OCR_MODEL=qwen3-vl:4b-instruct
OLLAMA_OCR_TIMEOUT_SECONDS=180
OLLAMA_OCR_MAX_TOKENS=4096

# Required only when OCR_MODEL=sarvam. Install sarvamai in the Flask Python env.
SARVAM_API_KEY=

# Application security. In production, expose only HTTPS through a trusted
# reverse proxy and list the exact browser origins that may call Flask.
SECURITY_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002
TRUST_PROXY_HEADERS=false
ENABLE_HSTS=false
AUTH_SESSION_TTL_SECONDS=28800
AUTH_RATE_LIMIT=10
QUERY_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=5
EVALUATION_RATE_LIMIT=120
SECURITY_RATE_LIMIT_MAX_KEYS=20000
MAX_FORM_MEMORY_BYTES=2097152

# Dedicated read-only machine credential for Prometheus. Use at least 32 random
# characters. If blank, metrics require an authenticated PIO administrator.
METRICS_SERVICE_TOKEN=

# Restricted RTI Section 4(1)(b) public-domain verification
# The verifier never leaves this operator-controlled allow-list. Additional
# department domains must be exact official hosts; never accept them from a query.
SECTION4_WEB_VERIFICATION_ENABLED=true
SECTION4_LIVE_VERIFICATION_ENABLED=true
SECTION4_LOCAL_INDEX_ENABLED=true
SECTION4_CACHE_TTL_SECONDS=21600
SECTION4_DISCLOSURE_TTL_SECONDS=86400
SECTION4_STATIC_TTL_SECONDS=604800
SECTION4_TENDER_TTL_SECONDS=10800
SECTION4_MAX_RESULTS_PER_SOURCE=10
SECTION4_MAX_VERIFIED_RESULTS=5
SECTION4_MAX_FETCHES_PER_SOURCE=3
SECTION4_REQUEST_TIMEOUT_SECONDS=30
SECTION4_CONNECT_TIMEOUT_SECONDS=8
SECTION4_TOTAL_TIMEOUT_SECONDS=45
SECTION4_MAX_REDIRECTS=3
SECTION4_MAX_HTML_BYTES=10485760
SECTION4_MAX_PDF_BYTES=104857600
SECTION4_MAX_PDF_PAGES=500
SECTION4_MAX_OCR_PAGES=20
SECTION4_MAX_EXTRACTED_CHARS=500000
SECTION4_MAX_CONCURRENT_PER_DOMAIN=2
SECTION4_MIN_REQUEST_INTERVAL_SECONDS=1.0
SECTION4_MAX_REQUESTS_PER_DOMAIN_PER_DAY=2000
SECTION4_CIRCUIT_FAILURE_THRESHOLD=3
SECTION4_CIRCUIT_RESET_SECONDS=300
SECTION4_PLAYWRIGHT_ENABLED=false
SECTION4_OCR_ENABLED=true
SECTION4_SEMANTIC_CLASSIFIER_ENABLED=true
SECTION4_ALLOWED_DOMAINS=sci.gov.in,www.sci.gov.in,api.sci.gov.in,cic.gov.in,www.cic.gov.in,siccg.gov.in,www.siccg.gov.in,rtionline.cg.gov.in,www.rtionline.cg.gov.in,cgeproc.cgstate.gov.in,eproc.cgstate.gov.in,gem.gov.in,www.gem.gov.in,bidplus.gem.gov.in,eprocure.gov.in,www.eprocure.gov.in
SECTION4_DEPARTMENT_DOMAINS=
SECTION4_CACHE_PATH=cache/section4_verification.sqlite3
SECTION4_USER_AGENT=CHiPS-RTI-Verification/1.0
SECTION4_CHATBOT_TEAM=rti-assistant
SECTION4_DEBUG=false

# RAG Evaluation and LLMOps Control Center
# Access is restricted to the active PIO user whose username matches this value
# and whose account has isAdmin=true. Keep credentials in data/pio_users.json.
EVALUATION_ADMIN_USERNAME=admin
RAG_EVAL_MAX_CASES=1000
RAG_EVAL_MAX_UPLOAD_BYTES=10485760
RAG_EVAL_MAX_WORKERS=1
RAG_EVAL_JUDGE_TIMEOUT_SECONDS=90
RAG_EVAL_ROUTER_TIMEOUT_SECONDS=60
RAG_EVAL_LATENCY_WARNING_MS=15000
RAG_EVAL_REGRESSION_THRESHOLD=0.05

# Sarvam usage-cost estimates in INR per one million tokens.
SARVAM_INPUT_COST_PER_1M_INR=4
SARVAM_CACHED_INPUT_COST_PER_1M_INR=2.5
SARVAM_OUTPUT_COST_PER_1M_INR=16

# Optional LLMOps connectors. Prometheus metrics are available without an SDK.
MLFLOW_TRACKING_URI=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional shared secret required for force_refresh=true. Leave blank to reject
# all force-refresh requests; ordinary verification and retry remain available.
SECTION4_FORCE_REFRESH_TOKEN=
