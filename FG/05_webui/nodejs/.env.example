# ── Required ────────────────────────────────────────────────────────────────
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000
FLASK_URL=http://localhost:5000
NODE_ENV=development
JWT_EXPIRY=8h
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002
TRUST_PROXY_HEADERS=false
ENABLE_HSTS=false
AUTH_RATE_LIMIT=10
QUERY_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=5
SECURITY_RATE_LIMIT_MAX_KEYS=20000
AUTH_SESSION_TTL_MS=28800000
AUTH_SESSION_MAX_ITEMS=10000
METRICS_SERVICE_TOKEN=

# ── Users ────────────────────────────────────────────────────────────────────
# Add users by running:  npm run add-user
# Paste the printed line below. Username is the part after USER_
# Example (do NOT use this hash in production):
# USER_OJASH=$2b$10$examplehashexamplehashexamplehashexamplehash
