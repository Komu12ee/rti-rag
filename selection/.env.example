NODE_ENV=development
PORT=3000
OTP_AUTH_ENABLED=true

# Required in production. Generate at least 32 random characters and store it
# in the deployment secret manager, not in source control.
AUTH_TOKEN_SECRET=
AUTH_SESSION_TTL_MS=28800000
OTP_RATE_LIMIT=10
AUTO_LAUNCH_ENABLED=false

# SMTP and database values are deployment-specific.
DB_PATH=selection/data/auth.db
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
